{
    "name": "study/events",
    "type": "typo3-cms-extension",
    "description": "Events - A learning extension for managing and displaying scheduled activities",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Study\\Events\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "events"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3.1",
        "squizlabs/php_codesniffer": "^4.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/coding-standards": "^0.9.0",
        "typo3/testing-framework": "^10.0@dev"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "@test:functional",
        "check": [
            "@phpcs",
            "@cs:check",
            "@phpstan",
            "@test"
        ],
        "test:functional": "phpunit --configuration=phpunit.xml.dist --testdox"
    },
    "autoload-dev": {
        "psr-4": {
            "Study\\Events\\Tests\\": "Tests/"
        }
    }
}
