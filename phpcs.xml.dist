<?xml version="1.0"?>
<ruleset name="Events extension">
    <description>PSR-12 checks for our extension. TYPO3-specific style is checked by PHP-CS-Fixer.</description>
    <file>Classes</file>
    <file>Configuration</file>
    <file>ext_localconf.php</file>
    <file>Tests</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- TYPO3's PER-CS rules allow single-line empty constructors.
             PHP-CS-Fixer enforces brace placement for this project. -->
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
    </rule>
</ruleset>
